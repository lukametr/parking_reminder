rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public lot map used by the app. Writes only via Admin/Console.
    match /parkings/{lotId} {
      allow read: if true;
      allow write: if false;
    }

    // Private: never world-readable/writable. App stores sessions locally.
    // When Firebase Auth is added, replace with request.auth.uid checks.
    match /user_parkings/{docId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
